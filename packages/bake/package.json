    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "msdf-bmfont-xml": "^2.7.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5"
  }
}
